# Copy this file to ".env" and fill in the values. Never commit ".env".

# Connection string from MongoDB Atlas (Connect -> Drivers).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=utron

# Signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

PORT=3000

# The one account that can sign in. "npm run seed" creates it and stores
# only a bcrypt hash of the password. Choose the password here, in .env,
# so it is never committed to the repository.
DEMO_EMAIL=johndoe@onion.edu
DEMO_NAME=John Doe
DEMO_PASSWORD=choose-a-password

# Shown in the UI, and used by the seed script when it creates courses.
TERM_NAME=Fall 2026
EVAL_CLOSES_AT=2026-12-30T23:59:00-05:00
